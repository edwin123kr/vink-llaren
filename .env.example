# Databas. SQLite lokalt; byt till en Postgres-URL (Supabase/Neon) senare.
DATABASE_URL="file:./.data/dev.db"

# AI-läge: "mock" = låtsasläge utan nyckel (deterministiska exempelsvar), "live" = riktiga anrop till Claude
AI_MODE="mock"
# Behövs bara när AI_MODE="live". Läses enbart på servern.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Konton
# Om satt måste man ange koden för att skapa konto (dela den med dina vänner). Tomt = vem som helst kan registrera sig.
REGISTRERINGSKOD=""
# Högsta antal AI-anrop per konto och dygn i live-läge, så att vänner inte drar iväg kostnaden. 0 = ingen gräns.
AI_GRANS_PER_DAG="40"
