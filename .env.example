# Databas (Postgres). På Vercel sätts de här automatiskt när du kopplar en Neon-databas.
# Lokalt: klistra in samma adresser från Vercel/Neon, eller använd en egen Postgres (t.ex. Postgres.app).
DATABASE_URL="postgresql://user:password@host/vinkallaren?sslmode=require"
# Valfri: adress utan anslutningspool, används för migreringar (Neon: "DATABASE_URL_UNPOOLED").
DATABASE_URL_UNPOOLED=""

# AI-läge: "mock" = låtsasläge utan nyckel (deterministiska exempelsvar), "live" = riktiga anrop till Claude
AI_MODE="mock"
# Behövs bara när AI_MODE="live". Läses enbart på servern.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Konton
# Om satt måste man ange koden för att skapa konto (dela den med dina vänner). Tomt = vem som helst kan registrera sig.
REGISTRERINGSKOD=""
# Högsta antal AI-anrop per konto och dygn i live-läge, så att vänner inte drar iväg kostnaden. 0 = ingen gräns.
AI_GRANS_PER_DAG="40"

# AI-tjänst i live-läge: "anthropic" (Claude, kräver ANTHROPIC_API_KEY) eller "gemini" (Googles gratisnivå, kräver GEMINI_API_KEY).
# Lämnas tomt väljs gemini om bara GEMINI_API_KEY finns.
AI_PROVIDER=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
